# Copy to infra/postgresql/.env
POSTGRES_DB=ciam_lab
POSTGRES_USER=ciam_app
POSTGRES_PASSWORD=ciam_lab_dev
POSTGRES_PORT=5432

# Optional pgAdmin (docker compose --profile admin up)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@ciam-lab.local
PGADMIN_PASSWORD=ciam_lab_dev

# Connection string for apps
DATABASE_URL=postgresql://ciam_app:ciam_lab_dev@localhost:5432/ciam_lab
