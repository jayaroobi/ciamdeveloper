# SAML Service Provider
PORT=3000
SESSION_SECRET=change-me-in-production

# Entity ID must match metadata and AM remote SP config
SAML_ENTITY_ID=urn:ciam-lab:saml-sp
SAML_ACS_URL=http://localhost:3000/saml/acs
SAML_CALLBACK_URL=http://localhost:3000/saml/acs

# After exporting IdP metadata from AM, place file here:
IDP_METADATA_PATH=./metadata/idp-metadata.xml

# Optional: PostgreSQL audit logging (start infra first)
# DATABASE_URL=postgresql://ciam_app:ciam_lab_dev@localhost:5432/ciam_lab
