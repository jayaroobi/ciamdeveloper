# Local / dry-run overrides (do not commit real tokens)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-4-20250514-v1:0
SIDEYE_SECRET_ID=sideeye/tokens
SIDEYE_STATE_DIR=./.sideeye-state
SIDEYE_LOG_LEVEL=INFO

# Or inject Secrets Manager JSON locally instead of AWS:
# SIDEYE_TOKENS_JSON={"bitbucket_token":"...","sonar_token":"...","jira_token":"...","jira_email":"...","octopus_api_key":"..."}

SIDEYE_CIAM_WORKSPACE=ciam
SIDEYE_CIAM_REPOS=identity-api,am-config
SIDEYE_CHIP_WORKSPACE=chip
SIDEYE_CHIP_REPOS=

SONAR_URL=https://sonarqube.example.internal
JIRA_URL=https://jira.example.internal
OCTOPUS_URL=https://octopus.example.internal
