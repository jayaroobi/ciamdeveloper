# Copy to forgeops/config/env.local and source before running scripts
# cp forgeops/config/env.example forgeops/config/env.local

export FORGEOPS_REPO="${FORGEOPS_REPO:-$HOME/forgeops}"
export FORGEOPS_TAG="2026.2.1"
export FORGEOPS_FQDN="forgeops.example.com"
export FORGEOPS_ENV_NAME="my-env"
export FORGEOPS_NAMESPACE="my-namespace"
export FORGEOPS_CLUSTER_ISSUER="default-issuer"
